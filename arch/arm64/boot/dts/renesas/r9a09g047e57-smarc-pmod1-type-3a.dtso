/*
 * RZ/G3E SMARC Carrier-II PMOD1 Type 3A (UART)
 *
 * PMOD1_3A pin     Signal             RZ/G3E pin
 *             1   SER0_CTS#          P80 (RSCI4 CTS4N)
 *             2   SER0_TX            P77 (RSCI4 TXD4)
 *             3   SER0_RX            P76 (RSCI4 RXD4)
 *             4   SER0_RTS#          P81 (RSCI4 RTS4N)
 *          5/11   GND
 *          6/12   PWR_PMOD1
 *             7   GPIO10             P65
 *             8   GPIO11             P56
 *             9   GPIO12             P66
 *            10   GPIO13             P64
 *
 * Set SYS.5 on the SoM to OFF (SW_LCD_EN = 0 in the base DTS) and
 * SW_OPT_MUX.4 on the carrier to OFF (SW_SER0_PMOD = 1). This routes
 * SER0 to PMOD1 and enables the UART level shifter.
 * Applying this overlay enables RSCI4 unconditionally; apply it only
 * with the above routing. Base-DTS macros are not visible to overlays.
 *
 * For auxiliary GPIOs, route GPIO10 to PMOD1 with SW_GPIO_OPT_SEL and
 * enable the GPIO12/13 level shifter with SW_GPIO_PMOD high. Select
 * the module supply with PMOD_PWR_SEL. GPIOs are left unclaimed for
 * the attached module.
 */

/dts-v1/;
/plugin/;

#include <dt-bindings/pinctrl/renesas,r9a09g047-pinctrl.h>

&pinctrl {
	rsci4_pins: rsci4 {
		pinmux = <RZG3E_PORT_PINMUX(7, 6, 5)>, /* RXD4 */
			 <RZG3E_PORT_PINMUX(7, 7, 5)>, /* TXD4 */
			 <RZG3E_PORT_PINMUX(8, 0, 6)>, /* CTS4N */
			 <RZG3E_PORT_PINMUX(8, 1, 5)>; /* RTS4N */
		bias-pull-up;
	};
};

&rsci4 {
	pinctrl-0 = <&rsci4_pins>;
	pinctrl-names = "default";
	uart-has-rtscts;
	status = "okay";
};
